{
    "name": "@cadscript/cadscript",
    "version": "0.1.0",
    "exports": "./src/mod.ts",
    "tasks": {
        "compile": "deno run -A scripts/compile.ts",
        "registry": "deno run -A scripts/gen-registry.ts",
        "check": "deno check src/ examples/ scripts/",
        "test": "deno test -A src/",
        "fmt": "deno fmt"
    },
    "fmt": {
        "useTabs": false,
        "indentWidth": 4,
        "lineWidth": 79,
        "semiColons": false,
        "singleQuote": false,
        "newLineKind": "lf"
    },
    "unstable": [
        "worker-options"
    ],
    "imports": {
